<?xml version="1.0" encoding="utf-8" ?>
<widget
    id="stoneworx.xspreadsheet.XSpreadsheet"
    pluginWidget="true"
    needsEntityContext="true"
    offlineCapable="true"
    supportedPlatform="Web"
    xmlns="http://www.mendix.com/widget/1.0/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.mendix.com/widget/1.0/ ../node_modules/mendix/custom_widget.xsd"
>
    <name>XSpreadsheet</name>
    <description>View and edit Excel files from a file document, with their styling and charts.</description>
    <studioProCategory>Display</studioProCategory>
    <studioCategory>Display</studioCategory>
    <helpUrl>https://github.com/StoneworxNL/data-spreadsheet-mendix/blob/main/README.md</helpUrl>
    <icon />
    <properties>
        <propertyGroup caption="General">
            <property key="fileDocument" type="file" required="false" allowUpload="true">
                <caption>Excel/XLSX File</caption>
                <description>File to load and (if editable), save.</description>
            </property>
            <property key="editable" type="boolean" defaultValue="false">
                <caption>Editable</caption>
                <description>Vs. View-only.</description>
            </property>
            <property key="isShowSave" type="boolean" defaultValue="true">
                <caption>Show Save Button</caption>
                <description>To save the file in the database.</description>
            </property>
            <property key="isShowDownload" type="boolean" defaultValue="false">
                <caption>Show Download Button</caption>
                <description />
            </property>
            <property key="saveCaption" type="textTemplate" required="false">
                <caption>Save caption</caption>
                <description>Text of the Save button. Default: Save.</description>
                <translations>
                    <translation lang="en_US">Save</translation>
                    <translation lang="nl_NL">Opslaan</translation>
                </translations>
            </property>
            <property key="downloadCaption" type="textTemplate" required="false">
                <caption>Download caption</caption>
                <description>Text of the Download button. Default: Download.</description>
                <translations>
                    <translation lang="en_US">Download</translation>
                    <translation lang="nl_NL">Downloaden</translation>
                </translations>
            </property>
            <property key="height" type="integer" defaultValue="0">
                <caption>Height (px)</caption>
                <description>
                    Total height of the spreadsheet, including its toolbar and sheet tabs. 0 = the height of the browser
                    window.
                </description>
            </property>
            <property key="widthOffset" type="integer" defaultValue="50">
                <caption>Width Offset (px)</caption>
                <description>
                    Space to keep free on the right of the window. The spreadsheet is never wider than its container
                    either.
                </description>
            </property>
        </propertyGroup>
        <propertyGroup caption="Export Options">
            <property key="saveMethod" type="enumeration" defaultValue="direct">
                <caption>Save method</caption>
                <description>
                    Direct: Save stores the file in the database right away. Through the file property: Save sets the
                    new file on the file document; commit the object in After Save Action (for example with a Save
                    changes action or a microflow).
                </description>
                <enumerationValues>
                    <enumerationValue key="direct">Direct</enumerationValue>
                    <enumerationValue key="property">Through the file property</enumerationValue>
                </enumerationValues>
            </property>
            <property key="afterSaveAction" type="action">
                <caption>After Save Action</caption>
                <description>To perform actions after saving the file: eg. show success message.</description>
            </property>
            <property key="bookSST" type="boolean" defaultValue="false">
                <caption>Book Shared String Table</caption>
                <description>Slower/+ memory intensive. Better compatibility w/ old iOS Numbers versions.</description>
            </property>
            <property key="compression" type="boolean" defaultValue="true">
                <caption>Compression</caption>
                <description>Use ZIP compression for ZIP-based formats (XLSX, XLSM, XLSB, NUMBERS).</description>
            </property>
            <property key="bookTypeEnum" type="enumeration" defaultValue="xlsx">
                <caption>Book Type</caption>
                <description>
                    File format for Download; the file name's extension follows it. Save always keeps the format of the
                    loaded file.
                </description>
                <enumerationValues>
                    <enumerationValue key="xlsx">xlsx</enumerationValue>
                    <enumerationValue key="xlsm">xlsm</enumerationValue>
                    <enumerationValue key="xlsb">xlsb</enumerationValue>
                    <enumerationValue key="biff8">xls</enumerationValue>
                    <enumerationValue key="numbers">numbers</enumerationValue>
                    <enumerationValue key="csv">csv</enumerationValue>
                    <enumerationValue key="txt">txt</enumerationValue>
                    <enumerationValue key="html">html</enumerationValue>
                </enumerationValues>
            </property>
            <property key="typeEnum" type="enumeration" defaultValue="array">
                <caption>Type</caption>
                <description>
                    Deprecated: files are always generated as binary data. Kept for existing apps.
                </description>
                <enumerationValues>
                    <enumerationValue key="array">Array</enumerationValue>
                    <enumerationValue key="base64">Base 64</enumerationValue>
                    <enumerationValue key="binary">Binary</enumerationValue>
                    <enumerationValue key="string">String</enumerationValue>
                </enumerationValues>
            </property>
            <property key="cellStyles" type="boolean" defaultValue="false">
                <caption>Cell Styles</caption>
                <description>Save style/theme info.</description>
            </property>
        </propertyGroup>
    </properties>
</widget>
